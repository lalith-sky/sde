{
  "manifest_version": 3,
  "name": "Visual AI Agent Monitor",
  "version": "1.0.0",
  "description": "Periodically captures screenshots of the active browser tab, processes them via AI, and tracks productivity timelines.",
  "minimum_chrome_version": "88",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Visual AI Agent"
  }
}

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017/visual-ai-agent

# JWT Secret (Change this in production!)
JWT_SECRET=super_secret_visual_ai_agent_token_key_123456

# Google Gemini AI API Key (Optional - uses mock analysis if not provided)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Notes:
# - For production, use a strong random JWT_SECRET
# - For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/dbname
# - Gemini API is optional; system uses intelligent mock analysis without it
